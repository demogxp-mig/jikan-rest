# Auto detect text files and perform LF normalization
* text=auto

# Full catalog snapshots exceed GitHub's regular per-file size limit.
exports/*.json filter=lfs diff=lfs merge=lfs -text

# Force batch and powershell scripts to always use CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Force bash scripts to always be LF
*.sh text eol=lf
